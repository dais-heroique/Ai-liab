{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "version":2,
  "buildCommand":"node scripts/prepare-site.mjs && npm run build",
  "installCommand":"npm install",
  "headers":[{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=(), payment=()"},{"key":"X-Frame-Options","value":"SAMEORIGIN"},{"key":"X-Powered-By","value":""},{"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.stripe.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"}]},{"source":"/static/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=86400, stale-while-revalidate=604800"}]}],
  "redirects":[{"source":"/landing","destination":"/","permanent":true},{"source":"/api","destination":"/docs","permanent":true}],
  "routes":[{"src":"/static/(.*)","dest":"/static/$1"},{"src":"/robots.txt","dest":"/static/robots.txt"},{"src":"/sitemap.xml","dest":"/static/sitemap.xml"},{"src":"/favicon.ico","dest":"/static/conforva-mark.svg"},{"src":"/","dest":"/static/landing.html"},{"src":"/login","dest":"/static/auth.html"},{"src":"/dashboard","dest":"/static/dashboard.html"},{"src":"/chat","dest":"/static/chat.html"},{"src":"/pricing","dest":"/static/pricing.html"},{"src":"/security","dest":"/static/security.html"},{"src":"/compliance","dest":"/static/compliance.html"},{"src":"/docs","dest":"/static/docs.html"},{"src":"/privacy","dest":"/static/privacy.html"},{"src":"/terms","dest":"/static/terms.html"},{"src":"/faq","dest":"/static/faq.html"},{"src":"/404","dest":"/static/404.html"},{"src":"/ai-agent-security","dest":"/static/ai-agent-security.html"},{"src":"/ai-agent-governance","dest":"/static/ai-agent-governance.html"},{"src":"/ai-agent-guardrails","dest":"/static/ai-agent-guardrails.html"},{"src":"/ai-agent-action-governance","dest":"/static/ai-agent-action-governance.html"},{"src":"/ai-agent-authorization","dest":"/static/ai-agent-authorization.html"},{"src":"/ai-agent-observability","dest":"/static/ai-agent-observability.html"},{"src":"/ai-agent-risk-management","dest":"/static/ai-agent-risk-management.html"},{"src":"/ai-agent-security-for-ecommerce","dest":"/static/ai-agent-security-for-ecommerce.html"},{"src":"/ai-agent-security-for-finance","dest":"/static/ai-agent-security-for-finance.html"},{"src":"/ai-agent-security-for-customer-service","dest":"/static/ai-agent-security-for-customer-service.html"},{"src":"/blog/what-are-ai-agents","dest":"/static/blog-what-are-ai-agents.html"},{"src":"/blog/what-are-ai-agent-guardrails","dest":"/static/blog-what-are-ai-agent-guardrails.html"},{"src":"/blog/ai-agent-security-checklist","dest":"/static/blog-ai-agent-security-checklist.html"},{"src":"/blog/ai-agent-governance-framework","dest":"/static/blog-ai-agent-governance-framework.html"},{"src":"/blog/ai-agent-vs-chatbot","dest":"/static/blog-ai-agent-vs-chatbot.html"},{"src":"/v1/(.*)","dest":"/api/index.ts"},{"src":"/api/v1/(.*)","dest":"/api/index.ts"},{"src":"/api/chat","dest":"/api/chat.ts"},{"src":"/health","dest":"/api/index.ts"}]
}